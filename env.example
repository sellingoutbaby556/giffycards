# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to git. (.gitignore already excludes it.)

# From Stripe Dashboard -> Developers -> API keys.
# Use the TEST key (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret".
# When testing locally with the Stripe CLI, `stripe listen` prints this (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# The public base URL where this app is reachable. Locally this is fine as-is.
# In production set it to your real domain, e.g. https://store.yourdomain.com
PUBLIC_URL=http://localhost:4242

# Port to run on locally.
PORT=4242

# Currency for all prices.
CURRENCY=usd
